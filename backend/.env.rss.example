# Credenciais do PocketBase para o importador de RSS
# Copie este arquivo para .env.rss e preencha com os valores reais.
# Nunca comite o .env.rss no git.

PB_URL=http://127.0.0.1:8090
PB_EMAIL=seu-email@bitsafe.com.br
PB_PASSWORD=sua-senha

# Opcional: personalizar comportamento
# RSS_EXPIRA_HORAS=48   # notícias expiram após 48h (padrão)
# RSS_MAX_POR_FEED=5    # máximo de itens novos por feed por execução (padrão)
